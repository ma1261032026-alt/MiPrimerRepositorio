Algoritmo Ejercicio5
	Definir num Como Real
	num <- 5
	// Incializamos en un valor valido para entrar
	Mientras num >= 1  Y num <= 10 Hacer 
			Escribir "Ingrese un numero entre 1 y 10 (fuera de rango para salir):"
			leer num
	FinMientras
	
	Escribir "Numero invalido ingresado. Fin del programa."
FinAlgoritmo

